# Copy to .dev.vars for `wrangler dev`. Never set this in production.
# Lets /admin work on localhost without Cloudflare Access. It is ignored on any non-localhost hostname.
ACCESS_DEV_BYPASS=true

# Where Square sends customers back to locally (wrangler dev hides the port). Ignored off localhost.
DEV_ORIGIN=http://localhost:8787

# Square SANDBOX (optional; leave out and card payments stay "coming soon" locally too).
# SQUARE_APP_ID=sandbox-sq0idb-...
# SQUARE_APP_SECRET=sandbox-sq0csb-...
# SQUARE_TOKEN_ENC_KEY=   # 32 random bytes, base64
# SQUARE_WEBHOOK_SIGNATURE_KEY=
